# ============================================================
# Configuracion del proveedor de mapas (Leaflet / react-leaflet)
# Copiar a `.env.local` para desarrollo y cargar las mismas
# variables en Vercel (Project Settings > Environment Variables).
# ============================================================

# Proveedor de mapas: maptiler | mapbox | google | arcgis | positron
# (positron y arcgis NO requieren API key)
VITE_MAP_PROVIDER=maptiler

# API key / access token del proveedor. Se inyecta en la URL de tiles.
VITE_MAP_API_KEY=

# Opcional: sobreescribe por completo la plantilla de URL de tiles
# Debe incluir los placeholders {z} {x} {y} (y opcionalmente {s} {r}).
# Ejemplo: VITE_MAP_TILES_URL=https://api.maptiler.com/maps/streets-v2/{z}/{x}/{y}.png?key=TU_KEY
VITE_MAP_TILES_URL=

# Opcional: texto de atribucion personalizado (HTML permitido)
VITE_MAP_ATTRIBUTION=
